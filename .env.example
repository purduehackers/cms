# Payload
PAYLOAD_SECRET=

# Turso (libSQL). For local dev, use file:./dev.db and leave the token blank.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Cloudflare Email Sending. The token needs Account:Email Sending:Edit, and the
# From must sit on an onboarded sending subdomain (ours is mail.purduehackers.com).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Email template asset origin (defaults to email-assets.purduehackers.com)
EMAIL_ASSETS_URL=

# Triggers Vercel ISR revalidation for Events Site
ISR_REVALIDATION_TOKEN=
